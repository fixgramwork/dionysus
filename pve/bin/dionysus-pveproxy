#!/usr/bin/env perl

use strict;
use warnings;

use FindBin;
use Getopt::Long qw(GetOptions);
use HTTP::Daemon;
use HTTP::Response;
use HTTP::Status qw(:constants);
use JSON::PP qw(encode_json);
use lib "$FindBin::Bin/../lib";
use lib '/usr/share/perl5';

use Dionysus::PVE::API;

my %config = (
    listen => $ENV{DIONYSUS_PVE_PROXY_LISTEN} || '0.0.0.0:8006',
    proc_root => $ENV{DIONYSUS_PROC_ROOT} || '/proc',
    sys_root => $ENV{DIONYSUS_SYS_ROOT} || '/sys',
    profiles_dir => $ENV{DIONYSUS_PROFILES_DIR} || '/usr/share/dionysus/profiles',
    ollama_api => $ENV{DIONYSUS_OLLAMA_API} || 'http://127.0.0.1:11434',
    www_root => $ENV{DIONYSUS_PVE_WWW} || "$FindBin::Bin/../www",
);

GetOptions(
    'listen=s' => \$config{listen},
    'proc-root=s' => \$config{proc_root},
    'sys-root=s' => \$config{sys_root},
    'profiles-dir=s' => \$config{profiles_dir},
    'ollama-api=s' => \$config{ollama_api},
    'www-root=s' => \$config{www_root},
) or die "invalid arguments\n";

my ($host, $port) = split(/:/, $config{listen}, 2);
$host = '0.0.0.0' if !defined($host) || $host eq '';
$port = 8006 if !defined($port) || $port eq '';

my $api = Dionysus::PVE::API->new(%config);
my $daemon = HTTP::Daemon->new(
    LocalAddr => $host,
    LocalPort => $port,
    ReuseAddr => 1,
) or die "failed to listen on $config{listen}: $!\n";

print "[dionysus-pveproxy] listening on $host:$port\n";

while (my $connection = $daemon->accept) {
    while (my $request = $connection->get_request) {
        my $path = $request->uri->path;

        if ($request->method eq 'OPTIONS') {
            $connection->send_response(_empty_response(HTTP_NO_CONTENT));
            next;
        }

        if ($path =~ m{^/api2/json/}) {
            my ($status, $payload) = $api->handle($request->method, $path, $request->content);
            $connection->send_response(_json_response($status, $payload));
            next;
        }

        if ($path eq '/' || $path eq '/index.html') {
            $connection->send_response(_file_response("$config{www_root}/index.html", 'text/html; charset=utf-8'));
            next;
        }

        if ($path =~ m{^/static/([A-Za-z0-9._-]+)$}) {
            $connection->send_response(_file_response("$config{www_root}/static/$1", _content_type($1)));
            next;
        }

        $connection->send_response(_json_response(HTTP_NOT_FOUND, { errors => { path => 'not found' }, data => undef }));
    }
    $connection->close;
}

sub _json_response {
    my ($status, $payload) = @_;
    my $response = HTTP::Response->new($status);
    $response->header('Content-Type' => 'application/json');
    _cors($response);
    $response->content(encode_json($payload));
    return $response;
}

sub _empty_response {
    my ($status) = @_;
    my $response = HTTP::Response->new($status);
    _cors($response);
    return $response;
}

sub _file_response {
    my ($path, $content_type) = @_;
    return _json_response(HTTP_NOT_FOUND, { errors => { path => 'not found' }, data => undef }) if !-f $path;

    my $fh;
    if (!open($fh, '<', $path)) {
        return _json_response(HTTP_NOT_FOUND, { errors => { path => 'not found' }, data => undef });
    }

    local $/;
    my $content = <$fh>;
    close($fh);

    my $response = HTTP::Response->new(HTTP_OK);
    $response->header('Content-Type' => $content_type);
    _cors($response);
    $response->content($content);
    return $response;
}

sub _cors {
    my ($response) = @_;
    $response->header('Access-Control-Allow-Origin' => '*');
    $response->header('Access-Control-Allow-Headers' => 'Content-Type');
    $response->header('Access-Control-Allow-Methods' => 'GET, POST, OPTIONS');
}

sub _content_type {
    my ($name) = @_;
    return 'text/css' if $name =~ /\.css$/;
    return 'application/javascript' if $name =~ /\.js$/;
    return 'image/svg+xml' if $name =~ /\.svg$/;
    return 'application/octet-stream';
}
