[Unit]
Description=Dionysus Ollama RAM metrics daemon
Documentation=https://github.com/fixgramwork/dionysus
After=network-online.target dionysus-network.service dionysus-llm-swap.service
Wants=network-online.target dionysus-network.service dionysus-llm-swap.service

[Service]
Type=simple
EnvironmentFile=-/etc/dionysus/pve.env
ExecStart=/usr/sbin/dionysusd metricsd --proc-root ${DIONYSUS_PROC_ROOT} --sys-root ${DIONYSUS_SYS_ROOT} --ollama-api ${DIONYSUS_OLLAMA_API} --metrics-db ${DIONYSUS_METRICS_DB} --interval ${DIONYSUS_METRICS_INTERVAL_SECONDS} --retention-days ${DIONYSUS_METRICS_RETENTION_DAYS}
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
