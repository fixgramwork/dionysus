[Unit]
Description=Dionysus PVE API daemon
Documentation=https://github.com/fixgramwork/dionysus
After=network-online.target dionysus-llm-swap.service
Wants=network-online.target dionysus-llm-swap.service

[Service]
Type=simple
EnvironmentFile=-/etc/dionysus/pve.env
ExecStart=/usr/sbin/dionysus-pvedaemon --listen ${DIONYSUS_PVE_DAEMON_LISTEN} --proc-root ${DIONYSUS_PROC_ROOT} --sys-root ${DIONYSUS_SYS_ROOT} --profiles-dir ${DIONYSUS_PROFILES_DIR} --ollama-api ${DIONYSUS_OLLAMA_API}
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
