# Persistent Dionysus network settings.
# Copy this file to /etc/dionysus/network.env in the target rootfs and edit it
# once for the machine. Keep mode 0600 when a Wi-Fi PSK is stored here.

DIONYSUS_NETWORK_ENABLED=1
DIONYSUS_NETWORK_MODE=none

# LAN is opt-in because this installer may run on an existing server whose
# primary interface is already managed by another network stack.
DIONYSUS_LAN_ENABLED=0
DIONYSUS_LAN_IFACE=eth0
DIONYSUS_LAN_IPV4_METHOD=dhcp
DIONYSUS_LAN_IPV4_ADDRESS=
DIONYSUS_LAN_IPV4_GATEWAY=
DIONYSUS_LAN_DNS=

# Wi-Fi is opt-in because a missing SSID should not break first boot.
DIONYSUS_WIFI_ENABLED=0
DIONYSUS_WIFI_IFACE=wlan0
DIONYSUS_WIFI_COUNTRY=KR
DIONYSUS_WIFI_SSID=
DIONYSUS_WIFI_PSK=
DIONYSUS_WIFI_PSK_HASH=
DIONYSUS_WIFI_SCAN_SSID=0

# Use dhcp for normal networks. Use static with the IPv4 fields below when
# the machine must keep a fixed address across boots.
DIONYSUS_WIFI_IPV4_METHOD=dhcp
DIONYSUS_WIFI_IPV4_ADDRESS=
DIONYSUS_WIFI_IPV4_GATEWAY=
DIONYSUS_WIFI_DNS=

DIONYSUS_DHCP_CLIENT=auto
DIONYSUS_DHCP_TRIES=6
DIONYSUS_DHCP_TIMEOUT=5
DIONYSUS_RESOLV_CONF=/etc/resolv.conf
