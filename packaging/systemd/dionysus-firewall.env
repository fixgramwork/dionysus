# Persistent Dionysus firewall settings.
# Copy this file to /etc/dionysus/firewall.env in the target rootfs and edit it
# once for the machine. The control plane renders these values to nftables.

DIONYSUS_FIREWALL_ENABLED=0
DIONYSUS_FIREWALL_DEFAULT_INCOMING=drop
DIONYSUS_FIREWALL_DEFAULT_OUTGOING=accept
DIONYSUS_FIREWALL_ALLOW_ESTABLISHED=1
DIONYSUS_FIREWALL_ALLOW_LOOPBACK=1
DIONYSUS_FIREWALL_ALLOW_PING=1

# JSON array of managed rules. Keep SSH and the web console reachable before
# enabling a default-drop incoming policy.
DIONYSUS_FIREWALL_RULES='[{"name":"ssh","enabled":true,"direction":"in","action":"accept","protocol":"tcp","port":"22","comment":"SSH access"},{"name":"pve-web","enabled":true,"direction":"in","action":"accept","protocol":"tcp","port":"8006","comment":"Dionysus web console"}]'
